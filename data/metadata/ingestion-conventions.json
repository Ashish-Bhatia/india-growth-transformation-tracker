  "purpose": "Machine-readable conventions for provenance-preserving ingestion.",
  "authoritative_registry_seed_required": true,
  "source_registry_seeded": false,
  "indicator_registry_seeded": false,
  "acquisition_modes": ["automated", "semi_automated", "manual", "research_extraction"],
