  "freshness_statuses": ["Current", "Recent", "Stale", "Awaiting release"],
  "layers": ["raw", "clean", "derived"],
  "lineage": ["source", "dataset", "snapshot", "locator", "vintage", "observation", "transformation", "calculation", "publication"],
  "required_manifest_controls": ["acquisition_ref", "source", "dataset", "snapshot", "locator_ids", "validation_status", "transformation_metadata"],
  "hash_algorithm": "SHA-256",
